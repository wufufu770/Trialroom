#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
用 GitHub **Git Data API** 推送分支(绕过 git 协议)。

## 为什么不用 git push
本机到 `github.com:443` **TCP 层面不通**(只有 api.github.com 可达),
`git push` 必然 `Recv failure: 连接被对方重置`。
而 `gh auth` / `api.github.com` 是通的 —— 所以改走 REST API。

## 为什么推成**孤儿分支**
`POST /git/commits` 传 `parents: []` ⇒ 该分支**不与 main 有任何祖先关系**。
好处:
  - 线上 GitHub Pages(从 main 构建)**完全不受影响**
  - 之后 main 前进也不会与它产生冲突
  - 任何人 merge 时都会看到"无共同祖先",需要显式处理,不会误合

## 安全
- 敏感文件在 commit 前已由 .githooks/pre-commit + 手工双重核对排除
  (server/data/、node_modules/、qa/、*.api_token、*.master_key、*.db*)
- token 只在内存里用,从不落盘;从 `gh auth token` 取
- 失败即停,不做任何"部分推送"式的补救

用法:python3 scripts/push-via-api.py
"""
import base64
import concurrent.futures as cf
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

REPO = "wufufu770/Tryout"
BRANCH = "fix/83-issues"
API = "https://api.github.com"
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

MESSAGE = (
    "fix: R1-R51 自主测试循环的 83 处修复\n\n"
    "从 R1 到 R51 共修复 83 个真实缺陷。本分支只含代码与测试资产,QA 工作记录保留在本地。\n\n"
    "修复要点:\n"
    "- 评分器:接入题目级判据;修 ISSUE-070(截断 JSON 整条作废记 0 分,\n"
    "  把满分级答案拽到 C 档);限长 reasoning\n"
    "- Agent 保存:两步写改单事务端点(修版本链断裂);修版本元数据 4/4 静默丢失\n"
    "- 校验层:不可见字符(\\u0000/\\u180E)绕过 min(1) 被拦下\n"
    "- 移动端可访问性:点击目标全部达标(0 个 <24px),门禁由报告改为拦截\n"
    "- 构建:build.sh 补传 Dockerfile 已有的 APT_MIRROR/NPM_REGISTRY 开关;\n"
    "  新增资源回收,避免构建缓存累积撑满磁盘\n"
    "- e2e:新增 path-traversal(36 路由 × 8 payload)与 question-reference\n\n"
    "测试体系:后端 241 条 / 前端 673 条单测;变异测试(11 点,91%,真实盲区 0);\n"
    "模糊/属性测试(5000+ 随机输入);语料结构校验闸门。门禁 38 项全绿。\n\n"
    "Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>"
)

# ⛔ 双保险:这些路径一律拒绝上传(与 .githooks/pre-commit 的规则保持一致)
FORBIDDEN = (
    ".api_token", ".master_key", ".env", ".pem", ".key",
    ".db", ".db-wal", ".db-shm", ".db-journal", ".sqlite",
)
FORBIDDEN_PREFIX = ("qa/", "server/data/", "docker/server/data/", "node_modules/")


def token():
    return subprocess.run(
        ["gh", "auth", "token"], capture_output=True, text=True, check=True
    ).stdout.strip()


TOK = token()


def api(method, path, body=None, raw=False, timeout=120):
    data = None
    headers = {
        "Authorization": f"Bearer {TOK}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "tryout-qa-push",
    }
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(f"{API}{path}", data=data, headers=headers, method=method)
    for attempt in range(4):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                payload = r.read()
                return payload if raw else (json.loads(payload) if payload else {})
        except urllib.error.HTTPError as e:
            detail = e.read()[:200].decode(errors="replace")
            # 403 可能是 secondary rate limit,退避重试
            if e.code in (403, 429) and attempt < 3:
                time.sleep(5 * (attempt + 1))
                continue
            raise RuntimeError(f"HTTP {e.code} {method} {path}\n{detail}")
        except urllib.error.URLError as e:
            if attempt < 3:
                time.sleep(3 * (attempt + 1))
                continue
            raise
    raise RuntimeError("重试耗尽")


def check_path(p):
    name = os.path.basename(p)
    if any(name.endswith(x) for x in FORBIDDEN):
        return f"文件名命中敏感规则:{p}"
    norm = p.replace("\\", "/")
    for pre in FORBIDDEN_PREFIX:
        if norm.startswith(pre) or f"/{pre}" in norm:
            return f"路径命中敏感前缀:{p}"
    return None


def files():
    out = subprocess.run(
        ["git", "ls-files", "-z"], cwd=ROOT, capture_output=True, check=True
    ).stdout.decode("utf-8", "replace")
    return [x for x in out.split("\0") if x]


# blob sha 是**内容寻址**的(同一内容永远同一 sha),所以可以缓存复用。
# 第一版 753 个 blob 全部上传成功,只是建 tree 超时 —— 不该为了一次 tree 失败重传 753 次。
CACHE_FILE = os.path.join(ROOT, ".push-blob-cache.json")
_cache = {}
if os.path.exists(CACHE_FILE):
    try:
        _cache = json.load(open(CACHE_FILE, encoding="utf-8"))
        print(f"  复用 blob 缓存 {len(_cache)} 条")
    except Exception:
        _cache = {}


def _save_cache():
    try:
        json.dump(_cache, open(CACHE_FILE, "w", encoding="utf-8"))
    except Exception:
        pass


def upload_blob(path):
    if path in _cache:
        return path, _cache[path], 0
    with open(os.path.join(ROOT, path), "rb") as f:
        raw = f.read()
    b64 = base64.b64encode(raw).decode()
    r = api("POST", f"/repos/{REPO}/git/blobs",
            {"content": b64, "encoding": "base64"}, timeout=180)
    _cache[path] = r["sha"]
    return path, r["sha"], len(raw)


def main():
    fs = files()
    print(f"▶ 分支 {BRANCH} · {len(fs)} 个文件 · 孤儿分支(不影响 main 与 Pages)")

    # 1) 敏感文件双保险:这里再查一遍,不依赖 pre-commit
    bad = [(p, r) for p in fs if (r := check_path(p))]
    if bad:
        print("⛔ 敏感文件拦截,已中止:")
        for p, why in bad[:20]:
            print(f"   {p}  —— {why}")
        return 2
    print(f"  ✅ 敏感文件预检通过({len(fs)} 个文件)")

    total_bytes = sum(os.path.getsize(os.path.join(ROOT, p)) for p in fs)
    print(f"  待上传 {total_bytes/1024/1024:.1f} MB")

    # 2) 取 blob sha —— ⭐ **零 API 调用**。
    #   Git 的 blob 对象名就是 `sha1("blob <长度>\0" + 内容)`,与 GitHub 的算法完全一致;
    #   而本地 commit 里已经有这些对象了,`git ls-tree -r` 一次就能全部拿到。
    #   (第一版老老实实传了 753 个 blob,结果 tree 超时 422 —— 那 753 次纯属白费。)
    tree_map = {}
    raw = subprocess.run(
        ["git", "ls-tree", "-r", "HEAD"], cwd=ROOT, capture_output=True, check=True
    ).stdout.decode("utf-8", "replace")
    for line in raw.split("\n"):
        if not line.strip():
            continue
        meta, _, path = line.partition("\t")
        mode, _typ, sha = meta.split()
        tree_map[path] = (mode, sha)
    entries = []
    for p in fs:
        if p not in tree_map:
            print(f"⛔ 文件不在 HEAD 树里(可能未被提交):{p}")
            return 2
        mode, sha = tree_map[p]
        entries.append({"path": p, "mode": mode, "type": "blob", "sha": sha})
    print(f"  ✅ 从本地 commit 取到 {len(entries)} 个 blob sha(0 次 API 上传)")

    _save_cache()
    # 3) 建 tree —— ⛔ 必须**分批增量**。
    #   一次性提交 753 个 entry 时 GitHub 返回 422:
    #     "Sorry, your request timed out. It's likely that your input was too large
    #      to process. Consider building the tree incrementally"
    #   官方做法:每批带上一次返回的 sha 作为 base_tree,逐层追加。
    BATCH = 120
    tree_sha = None
    for i in range(0, len(entries), BATCH):
        chunk = entries[i:i + BATCH]
        body = {"tree": chunk}
        if tree_sha:
            body["base_tree"] = tree_sha
        t = api("POST", f"/repos/{REPO}/git/trees", body, timeout=300)
        tree_sha = t["sha"]
        print(f"  tree 批 {i//BATCH + 1}: {len(chunk)} entries → {tree_sha[:12]}")
    print(f"  ✅ tree {tree_sha[:12]}(共 {len(entries)} entries,分 {BATCH} 批)")

    # 4) 建 commit(parents: [] ⇒ 孤儿分支)
    commit = api("POST", f"/repos/{REPO}/git/commits",
                 {"message": MESSAGE, "tree": tree_sha, "parents": []})
    print(f"  ✅ commit {commit['sha'][:12]}")

    # 5) 建 ref
    try:
        ref = api("POST", f"/repos/{REPO}/git/refs",
                  {"ref": f"refs/heads/{BRANCH}", "sha": commit["sha"]})
        print(f"  ✅ 分支已创建:{ref['ref']}")
    except RuntimeError as e:
        if "already exists" in str(e):
            ref = api("PATCH", f"/repos/{REPO}/git/refs/heads/{BRANCH}",
                      {"sha": commit["sha"], "force": True})
            print(f"  ✅ 分支已存在,已强制更新:{ref['ref']}")
        else:
            raise
    print(f"\n推送完成:https://github.com/{REPO}/tree/{BRANCH}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
