# Tryout 非 Docker 版环境变量示例
# 复制为 .env 并按需修改(.env 已在 .gitignore 中,不会提交)
# 或直接在启动脚本中设置系统环境变量

# ==== 基础配置 ====

# 监听端口(默认 3001)
PORT=3001

# 监听地址(默认 127.0.0.1,仅本机访问)
# 局域网访问设为 0.0.0.0(注意配合防火墙和认证使用)
HOST=127.0.0.1

# 数据目录(默认 ./data)
# Windows 下若路径含非 ASCII 字符(如用户名),必须改为纯英文路径,否则 sqlite3 无法打开
DB_DIR=./data

# 运行环境(production / development)
# production:禁用认证豁免、隐藏错误堆栈、启用 HSTS
NODE_ENV=development

# ==== 认证 ====

# 访问 token(多个用逗号分隔)
# 不设置则首次启动自动生成到 data/.api_token
# 注:变量名保留 INTERVIEWX_ 前缀,与旧版配置兼容
# INTERVIEWX_API_TOKEN=your-token-here

# 禁用认证(仅开发,production 环境禁止设为 1)
# INTERVIEWX_AUTH_DISABLED=1

# API Key 加密主密钥(用于加密供应商 API Key)
# 不设置则自动生成到 data/.master_key
# 生产环境务必通过环境变量注入,不要依赖自动生成的文件
# INTERVIEWX_MASTER_KEY=your-master-key-here

# ==== 网络与代理 ====

# 反向代理模式(后端在 Nginx 等反代后时设为 1)
# BEHIND_PROXY=1 时,Express 信任一层 X-Forwarded-For,req.ip 取真实客户端 IP
# 不设置时,req.ip 为 TCP 连接地址(最安全,防 XFF 伪造绕过限流)
# BEHIND_PROXY=1

# CORS 白名单(逗号分隔,默认允许本地开发端口)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://localhost:5180

# ==== LLM 配置 ====

# Ollama 本地模型地址(非 Docker 版默认指向本机)
OLLAMA_URL=http://localhost:11434/v1

# LLM 请求超时(毫秒,默认 60s)
# LLM_TIMEOUT_MS=60000

# 流式首 token 超时(毫秒,默认 30s,超时则中断防止上游 hang)
# LLM_FIRST_TOKEN_TIMEOUT_MS=30000

# 日 token 预算(默认 50 万,超出拒绝新请求)
DAILY_TOKEN_BUDGET=500000

# ==== 日志 ====

# 日志级别(trace/debug/info/warn/error,默认 info)
# LOG_LEVEL=info

# ==== Trialroom 平台层(2026-10 平台化新增) ====

# 管理员固定令牌(≥16 字符;轮换时旧值自动吊销;不设则无管理员)
# TRIALROOM_ADMIN_TOKEN=

# 开发用户引导端点(默认拒绝;仅本地开发显式开启)
# TRIALROOM_DEV=1

# —— 支付宝网页应用收款(三要素齐备后自动从 mock 切换真实收款) ——
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=          # 应用私钥(PEM 或裸 base64)
# ALIPAY_PUBLIC_KEY=               # 支付宝公钥(验签用,非应用公钥)
# ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do   # 沙箱;生产 https://openapi.alipay.com/gateway.do
# ALIPAY_NOTIFY_URL=https://<你的域名>/pay/alipay/notify
# ALIPAY_RETURN_URL=
# ALIPAY_OAUTH_REDIRECT=https://<你的域名>/api/platform/auth/alipay/callback   # OAuth 登录回调;建议显式钉死,不设则按请求 Host 推导
# ⚠️ 危险:设 1 后跳过网关主机白名单,允许非官方网关域(任意构造的验签端点)。仅限本地桩测试,生产严禁开启。
# ALIPAY_TRUST_GATEWAY=0

# —— 接口限流与对外域名(R6 补录) ——
# API_RATE_GENERAL=120              # /api 通用限流(次/分钟/IP,默认 120)
# PUBLIC_BASE_URL=                  # 对外域名(分享卡/邀请链接用,如 https://trialroom.example);未设时分享卡印 localhost:5173

# —— MCP 暴露面 ——
# MCP_AUD=https://trialroom.example/mcp          # token 受众(不匹配即 401)
# MCP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9090

# —— κ 校准真实判官(OpenAI 兼容;不设则 mock 占位) ——
# TRIALROOM_LLM_BASE_URL=https://api.minimax.chat/v1
# TRIALROOM_LLM_MODEL=MiniMax-M2
# TRIALROOM_LLM_API_KEY=
